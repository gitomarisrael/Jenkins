pipeline {
    agent any

    environment {
        MY_VAR = "Valor"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
    }

    tools {
        maven 'MavenMule'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Munits') {
            steps {
                script {
                    bat 'mvn clean test'
                }
            }
        }
        
        stage('Publish Asset Exchange') {
            steps {

                configFileProvider([configFile(fileId: "Settings-Mulesoft", variable: 'MAVEN_SETTINGS_XML')]) {
                bat 'mvn -s $MAVEN_SETTINGS_XML clean deploy -DbusinessGroupId=${MULE_BUSINESSGROUPID} -Dmule.env=dev -Denviroment=Sandbox -DskipTest'
                }

                //bat 'mvn -s C:/Users/omarm/.m2/settings.xml clean deploy -DbusinessGroupId=${MULE_BUSINESSGROUPID} -Dmule.env=dev -Denviroment=Sandbox -DskipTest'
            }
        }
        
        stage('Deploy CloudHub 2.0') {
            steps {
                bat 'mvn -s C:/Users/omarm/.m2/settings.xml clean deploy -DmuleDeploy -Denvironment=Sandbox -DbusinessGroupId=b8f69e4d-f96e-47cb-bf59-5851d9268fef -Dtarget=Cloudhub-US-East-2 -Dreplicas=1 -DvCores=0.1 -Dmule.env=dev -DskipTest'
            }
        }
    }

    post {
        always {
            echo 'Pipeline finalizada'
        }
        success {
            echo 'Build exitosa'
        }
        failure {
            echo 'Build fallida'
        }
    }
}
