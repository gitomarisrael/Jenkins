pipeline {
    agent any  // Se ejecuta en cualquier agente disponible

    environment {
        // Variables de entorno (opcional)
    }

    options {
        timeout(time: 30, unit: 'MINUTES') // Tiempo máximo de ejecución
    }

    tools {
      maven 'MavenMule' // Nombre dado a la instalación de Maven en Jenkins
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm  // Obtiene el código del repositorio configurado
            }
        }
    }

        stage('Munits'){
            steps{
                script{
                    bat 'mvn clean test'
                }
            }
        }
        
        stage('Publish Asset Exchange') {
            steps {
                bat "mvn -s C:/Users/omarm/.m2/settings.xml clean deploy \
                     -DbusinessGroupId=b8f69e4d-f96e-47cb-bf59-5851d9268fef \
                     -Dmule.env=dev \
                     -Denviroment=Sandbox \
                     -DskipTest"
            }
        }
        
        stage('Deploy CloudHub 2.0') {
            steps {
                bat "mvn -s C:/Users/omarm/.m2/settings.xml clean deploy -DmuleDeploy -Denvironment=Sandbox -DbusinessGroupId=b8f69e4d-f96e-47cb-bf59-5851d9268fef \
                 -Dtarget=Cloudhub-US-East-2 -Dreplicas=1 -DvCores=0.1 -Dmule.env=dev -DskipTest"
            }
        }

    post {
        always {
            echo 'Pipeline finalizada'  // Mensaje que siempre se muestra al final del pipeline
        }
        success {
            echo 'Build exitosa'  // Mensaje que se muestra si el pipeline es exitoso
        }
        failure {
            echo 'Build fallida'  // Mensaje que se muestra si el pipeline falla
        }
    }
}
