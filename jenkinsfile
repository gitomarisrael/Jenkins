pipeline {
    agent any  // Se ejecuta en cualquier agente disponible

    environment {
        // Variables de entorno (opcional)
        MY_VAR = "Valor"
        BUSINESS_GROUP = "${BUSINESSGROUP}"
    }

    options {
        timeout(time: 30, unit: 'MINUTES') // Tiempo máximo de ejecución
    }

    tools {
      maven 'MavenMule' // Nombre dado a la instalación de Maven en Jenkins
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm  // Obtiene el código del repositorio configurado
            }
        }
        
        stage('Build') {
            steps {
                bat 'mvn clean package'  // Ejecuta la compilación del proyecto en Windows
            }
        }
        
        stage('Test') {
            steps {
                bat 'mvn test'  // Ejecuta pruebas unitarias en Windows
            }
        }
        
        stage('Deploy') {
            when {
                branch 'develop'  // Solo despliega en la rama 'main'
            }
            steps {
                bat 'mvn clean deploy -DbusinessGroupId=b8f69e4d-f96e-47cb-bf59-5851d9268fef -Dmule.env=dev -DskipTest -Denviroment=Sandbox'
                bat 'mvn clean deploy -DmuleDeploy -Denvironment=Sandbox -DbusinessGroupId=b8f69e4d-f96e-47cb-bf59-5851d9268fef -Dtarget=Cloudhub-US-East-2 -Dreplicas=1 -DvCores=0.1 -Dmule.env=dev -DskipTest'
            }
        }
    }

    post {
        always {
            echo 'Pipeline finalizada'  // Mensaje que siempre se muestra al final del pipeline
        }
        success {
            echo 'Build exitosa'  // Mensaje que se muestra si el pipeline es exitoso
        }
        failure {
            echo 'Build fallida'  // Mensaje que se muestra si el pipeline falla
        }
    }
}
